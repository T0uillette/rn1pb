---
// Ancienne page « Recherche », fusionnée dans « La liste » : redirige en gardant la requête (?q=).
import { url } from '../data/site';
const target = url('liste/');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>La liste · RN1PB?</title>
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
  </head>
  <body><p><a href={target}>La recherche se fait désormais dans La liste.</a></p></body>
</html>
