---
import '../styles/global.css';
import { render } from 'astro:content';
import { getSections, url, editorialPage } from '../data/site';
import { VIEW_KEY, VIEWS, DEFAULT_VIEW } from '../lib/view-mode.mjs';
import archivoUrl from '../styles/fonts/archivo-italic-latin.woff2?url';
import atkinsonUrl from '../styles/fonts/atkinson-400-latin.woff2?url';
const sections = await getSections();
const { Content: Exchange } = await render(await editorialPage('pied-de-page'));

interface Props { title?: string; description?: string; home?: boolean }
const { title, home = false, description = "Compilation critique du Rassemblement national : articles, votes, positions et archives, classés par rubrique." } = Astro.props;
const siteName = 'RN1PB?';
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const current = Astro.url.pathname;
const links = [
  { href: url('liste/'), label: 'La liste' },
  { href: url('methode/'), label: 'Plus d’informations' },
];
const cta = { href: url('proposer/'), label: 'Proposer une source' };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="application-name" content={siteName} />
    <title>{fullTitle}</title>
    <script is:inline define:vars={{ key: VIEW_KEY, views: VIEWS, fallback: DEFAULT_VIEW }}>
      let view = fallback;
      try { const v = localStorage.getItem(key); if (views.includes(v)) view = v; } catch {}
      document.documentElement.dataset.vue = view;
    </script>
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class={home ? 'is-home' : undefined}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url()} aria-label="RN1PB? — accueil">
          <span class="plate" aria-hidden="true"><span>RN1PB<i>?</i></span></span>
        </a>
        <nav class="nav-desktop" aria-label="Principal">
          <details class="menu" data-menu>
            <summary class="nav-link">Rubriques <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
            <ul>
              {sections.map((s) => (
                <li><a href={url(`rubriques/${s.slug}/`)} aria-current={current === url(`rubriques/${s.slug}/`) ? 'page' : undefined}>{s.short}</a></li>
              ))}
            </ul>
          </details>
          {links.map((l) => <a href={l.href} class="nav-link" aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>)}
          <a href={cta.href} class="btn btn-primary btn-cta" aria-current={current === cta.href ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> {cta.label}</a>
        </nav>
        <div class="nav-mobile">
          <a href={cta.href} class="btn btn-primary btn-cta" aria-current={current === cta.href ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg> Proposer</a>
          <details class="mobile-menu" data-menu>
            <summary class="burger" aria-label="Menu">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="burger-open" d="M4 7h16M4 12h16M4 17h16" /><path class="burger-close" d="M6 6l12 12M18 6L6 18" /></svg>
            </summary>
            <nav class="mobile-panel" aria-label="Menu principal">
              <ul class="mobile-links">
                {links.map((l) => <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>)}
              </ul>
              <p class="mobile-heading">Rubriques</p>
              <ul class="mobile-rubrics">
                {sections.map((s) => (
                  <li><a href={url(`rubriques/${s.slug}/`)} aria-current={current === url(`rubriques/${s.slug}/`) ? 'page' : undefined}>{s.short}</a></li>
                ))}
              </ul>
              <a href={cta.href} class="btn btn-primary mobile-cta">{cta.label}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer grain">
      <div class="wrap foot">
        <div class="foot-main">
          <p class="foot-title"><span class="plate" aria-hidden="true"><span>RN1PB<i>?</i></span></span><span class="sr">RN1PB?</span></p>
          <p>Ce site n’est affilié à aucun parti politique. Il rassemble des articles de presse et des sources publiques sur les agissements du Rassemblement National. Un travail militant pour rendre ces informations accessibles et permettre à chacun de se faire son opinion.</p>
          <div class="foot-exchange"><Exchange /></div>
        </div>
        <ul class="foot-links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a class="btn btn-primary btn-cta" href={cta.href}>{cta.label}</a></li>
        </ul>
        <p class="foot-note">Site statique, sans traceur ni service externe.</p>
      </div>
    </footer>
    <script>
      // Menus dépliants de l'en-tête : se ferment avec Échap, en cliquant ailleurs ou sur un lien.
      for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-menu]')) {
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
        document.addEventListener('click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        menu.addEventListener('click', (e) => {
          if ((e.target as Element).closest('a')) menu.open = false;
        });
      }
    </script>
  </body>
</html>
